# Copy to .env. Never commit .env with real credentials.
LEADHELPER_PORT=8090
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=
JIRA_MODE=server
BITRIX_WEBHOOK_URL=
CONFLUENCE_URL=
CONFLUENCE_TOKEN=
# IMAP over verified TLS. Obtain HOST from your mail administrator/provider.
MAIL_PROVIDER=imap
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_PASSWORD_FILE=
MAIL_SYNC_INTERVAL=20s
# Optional exact folder names separated by |; empty = all selectable folders.
MAIL_FOLDERS=
# Legacy provider: explicitly set MAIL_PROVIDER=graph to use it.
MS_GRAPH_ACCESS_TOKEN=
# SMTP sends only on an explicit Send action. Timeweb uses the IMAP credentials.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
ALLOW_LIVE_MAIL_SEND=true
